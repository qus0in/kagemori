{
  "name": "kagemori",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=DEP0040' vite",
    "build": "NODE_OPTIONS='--disable-warning=DEP0040' vite build",
    "preview": "NODE_OPTIONS='--disable-warning=DEP0040' vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check": "tsc -b",
    "check:lines": "NODE_OPTIONS='--disable-warning=DEP0040' node --experimental-strip-types scripts/check-line-limits.ts",
    "test": "NODE_OPTIONS='--disable-warning=DEP0040' node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:unit": "NODE_OPTIONS='--disable-warning=DEP0040' node --test --experimental-strip-types 'test/unit/**/*.test.ts'",
    "test:slice": "NODE_OPTIONS='--disable-warning=DEP0040' node --test --experimental-strip-types 'test/slice/**/*.test.ts'",
    "test:integration": "NODE_OPTIONS='--disable-warning=DEP0040' node --test --experimental-strip-types 'test/integration/**/*.test.ts'"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.7.4",
    "ky": "^2.1.0",
    "lru-cache": "^11.5.3",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.0.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.137.0"
  }
}
