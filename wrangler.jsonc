{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kagemori",
  "compatibility_date": "2026-09-24",
  "main": "./worker/index.ts",
  "vars": { "STORAGE_MODE": "persistent" },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kagemori-db",
      "database_id": "1103832b-f92e-4f4c-87ed-0c5114d6741e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "STUDY_SESSION_DO",
        "class_name": "StudySessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["StudySessionDO"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KAGEMORI_KV",
      "id": "320efce34fca4937a806633b0099a236"
    }
  ]
}
